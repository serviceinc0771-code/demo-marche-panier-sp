---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'Marché San-Pédro — Simulateur de panier',
  description = 'Catalogue marché avec fourchettes de prix FCFA (min / estimé / max). Démonstration indicative.',
} = Astro.props;

const path = Astro.url.pathname;
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <script src="/js/panier.js" is:inline></script>
  </head>
  <body class="min-h-screen flex flex-col bg-fond text-texte">
    <header class="sticky top-0 z-50 border-b border-bord bg-surface/95 backdrop-blur">
      <div class="mx-auto flex max-w-6xl items-center justify-between gap-3 px-4 py-3">
        <a href="/" class="flex items-center gap-2 min-w-0">
          <span class="text-2xl" aria-hidden="true">🛒</span>
          <div class="min-w-0">
            <div class="truncate font-extrabold text-primaire leading-tight">Marché San-Pédro</div>
            <div class="text-xs text-secondaire truncate">Simulateur de panier · FCFA</div>
          </div>
        </a>
        <nav class="flex items-center gap-1 sm:gap-2 shrink-0">
          <a
            href="/"
            class:list={[
              'rounded-lg px-2.5 py-1.5 text-sm font-semibold',
              path === '/' || path === '/index.html'
                ? 'bg-primaire text-white'
                : 'text-secondaire hover:text-primaire',
            ]}
          >
            Catalogue
          </a>
          <a
            href="/panier"
            class:list={[
              'relative rounded-lg px-2.5 py-1.5 text-sm font-semibold',
              path.startsWith('/panier')
                ? 'bg-primaire text-white'
                : 'text-secondaire hover:text-primaire',
            ]}
            id="nav-panier"
          >
            Panier
            <span
              id="nav-badge"
              class="ml-1 inline-flex min-w-[1.25rem] items-center justify-center rounded-full bg-alerte px-1.5 text-[0.65rem] font-bold text-white hidden"
              >0</span
            >
          </a>
          <a
            href="/methodologie"
            class:list={[
              'hidden sm:inline rounded-lg px-2.5 py-1.5 text-sm font-semibold',
              path.startsWith('/methodologie')
                ? 'bg-primaire text-white'
                : 'text-secondaire hover:text-primaire',
            ]}
          >
            Méthodo
          </a>
        </nav>
      </div>
      <div class="border-t border-bord bg-[#FEF3C7] px-4 py-1.5 text-center text-xs font-semibold text-alerte">
        Estimations démo — prix indicatifs, non synchronisés avec un marché live
      </div>
    </header>

    <main class="flex-1 w-full">
      <slot />
    </main>

    <footer class="mt-auto border-t border-bord bg-surface">
      <div class="mx-auto max-w-6xl px-4 py-6 text-center text-sm text-secondaire">
        <p class="font-semibold text-texte">Marché San-Pédro — démonstration</p>
        <p class="mt-1">
          Prix en FCFA · fourchettes min / estimé / max ·
          <a href="/methodologie" class="text-primaire underline underline-offset-2">méthodologie</a>
        </p>
        <p class="mt-2 text-xs">Aucune transaction réelle · données fictives à titre pédagogique</p>
      </div>
    </footer>

    <script is:inline>
      (function () {
        function refreshBadge() {
          const el = document.getElementById('nav-badge');
          if (!el || !window.MarchePanier) return;
          const n = window.MarchePanier.countItems();
          if (n > 0) {
            el.textContent = String(n);
            el.classList.remove('hidden');
          } else {
            el.classList.add('hidden');
          }
        }
        document.addEventListener('DOMContentLoaded', refreshBadge);
        window.addEventListener('panier:change', refreshBadge);
      })();
    </script>
  </body>
</html>
