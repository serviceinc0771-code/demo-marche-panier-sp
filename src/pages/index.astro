---
import Layout from '../layouts/Layout.astro';
import ProductCard from '../components/ProductCard.astro';
import products from '../data/products.json';

const categories = [...new Set(products.map((p) => p.categorie))].sort();
---

<Layout title="Catalogue — Marché San-Pédro">
  <div class="mx-auto max-w-6xl px-4 py-6 pb-36">
    <div class="mb-6">
      <h1 class="text-2xl sm:text-3xl font-extrabold text-texte tracking-tight">
        Catalogue du marché
      </h1>
      <p class="mt-1 text-secondaire text-sm sm:text-base">
        {products.length} produits · fourchettes min / estimé / max en FCFA
      </p>
    </div>

    <!-- Filtres catégorie -->
    <div
      id="filtres"
      class="mb-6 flex gap-2 overflow-x-auto pb-2 -mx-1 px-1 scrollbar-thin"
      role="group"
      aria-label="Filtrer par catégorie"
    >
      <button type="button" class="chip active shrink-0" data-cat="all">Tous</button>
      {categories.map((cat) => (
        <button type="button" class="chip shrink-0" data-cat={cat}>{cat}</button>
      ))}
    </div>

    <div
      id="grille"
      class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4"
    >
      {products.map((p) => <ProductCard product={p} />)}
    </div>

    <p id="vide-filtre" class="hidden text-center py-12 text-secondaire">
      Aucun produit dans cette catégorie.
    </p>
  </div>

  <!-- Sticky panier bar -->
  <aside class="panier-sticky" id="sticky-panier" aria-live="polite">
    <div class="mx-auto max-w-6xl px-4 py-3">
      <div class="flex flex-wrap items-end justify-between gap-3">
        <div class="min-w-0">
          <p class="text-[0.65rem] uppercase tracking-wide font-bold text-secondaire">
            Total estimé du panier
          </p>
          <p class="total-geant" id="sticky-est">0&nbsp;FCFA</p>
          <div class="mt-1 flex flex-wrap gap-x-4 gap-y-0.5 text-sm font-bold">
            <span class="text-primaire">Min <span id="sticky-min">0</span></span>
            <span class="text-alerte">Max <span id="sticky-max">0</span></span>
            <span class="text-secondaire font-semibold" id="sticky-count">0 article</span>
          </div>
        </div>
        <a href="/panier" class="btn-cta inline-flex items-center justify-center h-12 px-6 text-base shrink-0">
          Voir le panier →
        </a>
      </div>
    </div>
  </aside>
</Layout>

<script define:vars={{ productsJson: JSON.stringify(products) }}>
  const PRODUCTS = JSON.parse(productsJson);

  function syncCard(card) {
    const id = card.dataset.id;
    const qty = window.MarchePanier.getQty(id);
    const input = card.querySelector('[data-qty]');
    if (input) input.value = String(qty);
  }

  function refreshSticky() {
    const t = window.MarchePanier.totals(PRODUCTS);
    const fmt = window.MarchePanier.formatCFA;
    document.getElementById('sticky-est').textContent = fmt(t.est);
    document.getElementById('sticky-min').textContent = fmt(t.min);
    document.getElementById('sticky-max').textContent = fmt(t.max);
    const c = document.getElementById('sticky-count');
    c.textContent =
      t.items === 0
        ? '0 article'
        : t.items === 1
          ? '1 article'
          : t.items + ' articles';
  }

  function refreshAll() {
    document.querySelectorAll('.card-produit').forEach(syncCard);
    refreshSticky();
  }

  document.addEventListener('DOMContentLoaded', () => {
    refreshAll();

    // Qty controls
    document.getElementById('grille').addEventListener('click', (e) => {
      const btn = e.target.closest('[data-action]');
      if (!btn) return;
      const card = btn.closest('.card-produit');
      if (!card) return;
      const id = card.dataset.id;
      const action = btn.dataset.action;
      if (action === 'plus') window.MarchePanier.add(id, 1);
      else if (action === 'minus') window.MarchePanier.add(id, -1);
      else if (action === 'add') {
        const input = card.querySelector('[data-qty]');
        let q = parseInt(input.value, 10) || 0;
        if (q < 1) q = 1;
        window.MarchePanier.setQty(id, q);
      }
      refreshAll();
    });

    document.getElementById('grille').addEventListener('change', (e) => {
      const input = e.target.closest('[data-qty]');
      if (!input) return;
      const card = input.closest('.card-produit');
      window.MarchePanier.setQty(card.dataset.id, input.value);
      refreshAll();
    });

    // Filters
    document.getElementById('filtres').addEventListener('click', (e) => {
      const chip = e.target.closest('[data-cat]');
      if (!chip) return;
      document.querySelectorAll('#filtres .chip').forEach((c) => c.classList.remove('active'));
      chip.classList.add('active');
      const cat = chip.dataset.cat;
      let visible = 0;
      document.querySelectorAll('.card-produit').forEach((card) => {
        const show = cat === 'all' || card.dataset.categorie === cat;
        card.classList.toggle('hidden', !show);
        if (show) visible++;
      });
      document.getElementById('vide-filtre').classList.toggle('hidden', visible > 0);
    });
  });

  window.addEventListener('panier:change', refreshAll);
</script>
